# Optional overrides. The compose file already defaults to
# ghcr.io/bblumhofer/...:eventing, so you only need this to use a different
# registry namespace or tag. Copy this file to `.env` and edit, or export the
# variables in your shell (e.g. `export IMAGE_OWNER=myuser`).
IMAGE_OWNER=bblumhofer
IMAGE_TAG=eventing
